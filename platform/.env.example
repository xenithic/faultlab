# ==============================================================================
# FaultLab Platform Backend Configuration Template
# ==============================================================================
# Copy this file to '.env' inside the platform/ directory for local development.
# WARNING: DO NOT COMMIT REAL SECRETS OR PRODUCTION PASSWORDS TO GIT.
# ==============================================================================

# Flask application entrypoint for CLI commands (e.g. flask db migrate / flask db upgrade)
FLASK_APP=run.py

# Environment profile: 'development', 'testing', or 'production'
FLASK_ENV=development

# Server port for the platform backend (defaults to 5050 to avoid target-app port collisions)
PORT=5050

# PostgreSQL Configuration (Local Development Defaults)
POSTGRES_USER=faultlab
POSTGRES_PASSWORD=faultlab_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=faultlab_platform

# Complete Database URI (optional override; if not set, constructed from POSTGRES_* vars above)
# DATABASE_URL=postgresql://faultlab:faultlab_dev_password@localhost:5432/faultlab_platform
